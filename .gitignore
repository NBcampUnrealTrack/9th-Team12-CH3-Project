# ============================================================
# Unreal Engine 5 + Rider .gitignore
# Project: CH3 Team12 / Unreal 5.8
# ============================================================

# ------------------------------------------------------------
# Unreal Engine generated folders
# ------------------------------------------------------------
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# Plugin generated folders
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/

# ------------------------------------------------------------
# Rider / JetBrains
# ------------------------------------------------------------
.idea/
.idea/**
*.sln.DotSettings.user

# ------------------------------------------------------------
# Visual Studio / generated solution files
# Rider can open .uproject directly, so generated solution files
# do not need to be committed for this project.
# ------------------------------------------------------------
.vs/
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.vsconfig

# ------------------------------------------------------------
# Build products / compiled binaries
# ------------------------------------------------------------
*.obj
*.o
*.lo
*.slo
*.pch
*.gch
*.dll
*.dylib
*.so
*.lib
*.a
*.la
*.lai
*.exe
*.out
*.app
*.ipa
Content/ParagonRampage/

# ------------------------------------------------------------
# Logs / temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.pdb
*.ilk

# ------------------------------------------------------------
# Unreal local automation / cache files
# ------------------------------------------------------------
*.tlog
*.lastbuildstate
*.received.txt

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Keep source/config/assets tracked
# ------------------------------------------------------------
!.gitignore
!.gitattributes
!*.uproject
!Source/**
!Config/**
!Content/**
!Plugins/**

# ------------------------------------------------------------
# Marketplace/sample assets kept local only
# ------------------------------------------------------------
Content/ParagonRampage/
Content/ParagonRampage/**
